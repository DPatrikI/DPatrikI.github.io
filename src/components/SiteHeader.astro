---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const prefix = home ? "" : "/";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Patrik Dóczy — home">
      <span aria-hidden="true">PD</span>
      <span>Patrik Dóczy</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        <li><a href={`${prefix}#projects`}>Projects</a></li>
        <li><a href={`${prefix}#profiles`}>Profiles</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
  </div>
</header>
