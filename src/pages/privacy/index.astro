---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Website privacy | Patrik Dóczy";
const description =
  "Plain-language privacy information for Patrik Dóczy’s website, which intentionally uses no analytics, cookies, accounts, or visitor tracking.";
---

<BaseLayout {title} {description} pathname="/privacy/">
  <header class="page-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span
          aria-current="page">Privacy</span
        >
      </nav>
      <p class="eyebrow">Website policy</p>
      <h1>Privacy without surprises.</h1>
      <p class="lede">
        This website is deliberately simple and collects no visitor data for
        Patrik.
      </p>
      <p class="updated">Last updated: 24 August 2026</p>
    </div>
  </header>

  <section class="section">
    <div class="shell content-grid">
      <aside>
        <p class="eyebrow">Related</p>
        <p><a href="/privacy/signalbriar/">Signalbriar privacy policy</a></p>
        <p><a href="/privacy/voleq/">VolEq privacy policy</a></p>
        <p><a href="/support/voleq/">VolEq support</a></p>
      </aside>
      <div class="prose">
        <h2>What this site does not collect</h2>
        <p>
          This website intentionally uses no analytics, cookies, accounts,
          forms, advertising scripts, or visitor-tracking technology. It has no
          application backend, so it does not collect information through one.
        </p>

        <h2>External services</h2>
        <p>
          Following an external link is governed by the relevant external
          service. Sending email is governed by your email provider and the
          recipient’s email provider.
        </p>

        <h2>GitHub Pages hosting</h2>
        <p>
          GitHub Pages necessarily processes ordinary hosting and network
          metadata, such as IP addresses and request information, under GitHub’s
          own terms and privacy statement. That infrastructure processing is
          separate from Patrik’s intentional collection, which this website does
          not perform.
        </p>
        <p>
          <a
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            >Read GitHub’s current privacy statement</a
          >.
        </p>

        <h2>Questions</h2>
        <p>
          Send privacy questions to{" "}
          <a href="mailto:doczy.patrik410@gmail.com"
            >doczy.patrik410@gmail.com</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
